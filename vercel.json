{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "bun install",
  "devCommand": "npm run dev",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "all" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://va.vercel-scripts.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https:; frame-ancestors 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/home/index.html" },
    { "source": "/transparency", "destination": "/transparency/index.html" },
    { "source": "/transparency/", "destination": "/transparency/index.html" },
    {
      "source": "/transparency/department-budgets",
      "destination": "/transparency/department-budgets/index.html"
    },
    {
      "source": "/transparency/department-budgets/",
      "destination": "/transparency/department-budgets/index.html"
    },
    {
      "source": "/bacolod-government-services",
      "destination": "/bacolod-government-services/index.html"
    },
    {
      "source": "/bacolod-government-services/",
      "destination": "/bacolod-government-services/index.html"
    },
    {
      "source": "/bacolod-fuel-prices",
      "destination": "/bacolod-fuel-prices/index.html"
    },
    {
      "source": "/bacolod-fuel-prices/",
      "destination": "/bacolod-fuel-prices/index.html"
    },
    {
      "source": "/bacolod-health-services",
      "destination": "/bacolod-health-services/index.html"
    },
    {
      "source": "/bacolod-health-services/",
      "destination": "/bacolod-health-services/index.html"
    },
    {
      "source": "/bacolod-transportation",
      "destination": "/bacolod-transportation/index.html"
    },
    {
      "source": "/bacolod-transportation/",
      "destination": "/bacolod-transportation/index.html"
    },
    {
      "source": "/bacolod-scholarships",
      "destination": "/bacolod-scholarships/index.html"
    },
    {
      "source": "/bacolod-scholarships/",
      "destination": "/bacolod-scholarships/index.html"
    },
    {
      "source": "/bacolod-barangays",
      "destination": "/bacolod-barangays/index.html"
    },
    {
      "source": "/bacolod-barangays/",
      "destination": "/bacolod-barangays/index.html"
    },
    {
      "source": "/transparency/national-projects",
      "destination": "/transparency/national-projects/index.html"
    },
    {
      "source": "/transparency/national-projects/",
      "destination": "/transparency/national-projects/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
